NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — enables Giphy search in post, comment, and repost composers (paste URL works without this)
# Create a free beta key at https://developers.giphy.com/dashboard/
NEXT_PUBLIC_GIPHY_API_KEY=your_giphy_api_key
# ISBNdb REST key — used by the Supabase Edge Function proxy (never expose as NEXT_PUBLIC_)
# Set the same value as a Supabase secret: supabase secrets set ISBNDB_API_KEY=...
ISBNDB_API_KEY=your_isbndb_api_key
