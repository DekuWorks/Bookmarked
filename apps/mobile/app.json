{
  "expo": {
    "name": "Bookmarked",
    "slug": "bookmarked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EEFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dekuworks.bookmarked",
      "icon": "./assets/brand/icon.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Bookmarked needs access to your photos so you can attach images to posts, comments, and messages.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/logo-circle.png",
        "backgroundColor": "#EADCF4"
      },
      "package": "com.dekuworks.bookmarked",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "bookmarked",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookmarked needs access to your photos so you can attach images to posts, comments, and messages."
        }
      ],
      "expo-iap"
    ],
    "owner": "dekuworks",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "766e1107-214a-4856-a372-441c5d68c530"
      }
    }
  }
}
