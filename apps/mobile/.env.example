# Bookmarked mobile — environment variables
#
# Copy this file to `.env` (git-ignored) and fill in the SAME Supabase project
# values the web app uses (apps/web/.env.local → NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY). Only EXPO_PUBLIC_* vars are read at build time
# (see src/constants/env.ts). Never commit real secrets or a populated `.env`.

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe for client use with RLS enabled)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
