# Copy to .env.stripe.local (gitignored) and fill in from Stripe Dashboard → Developers → API keys.
# Do not commit .env.stripe.local.
# Do not invent live price IDs — run ./scripts/setup-stripe-catalog.sh and paste the printed IDs.

STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE

# Bookmarked Plus — $5.99 / month (price_…)
STRIPE_PRICE_ID=price_YOUR_MONTHLY_PRICE_ID

# Bookmarked Plus — $59.99 / year (price_…)
STRIPE_PRICE_ID_YEARLY=price_YOUR_YEARLY_PRICE_ID

STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# After filling in:
#   set -a && source .env.stripe.local && set +a
#   ./scripts/setup-stripe-catalog.sh --live
#   ./scripts/supabase-cli.sh secrets set \
#     STRIPE_SECRET_KEY="$STRIPE_SECRET_KEY" \
#     STRIPE_PRICE_ID="$STRIPE_PRICE_ID" \
#     STRIPE_PRICE_ID_YEARLY="$STRIPE_PRICE_ID_YEARLY" \
#     STRIPE_WEBHOOK_SECRET="$STRIPE_WEBHOOK_SECRET"
