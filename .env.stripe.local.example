# Copy to .env.stripe.local (gitignored) and fill in from Stripe Dashboard → Developers → API keys (Live).
# Do not commit .env.stripe.local.

STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
STRIPE_PRICE_ID=price_YOUR_PRICE_ID
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

